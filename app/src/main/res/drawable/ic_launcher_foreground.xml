<?xml version="1.0" encoding="utf-8"?>
<!--
  云楼投屏品牌图形：云 + 播放键（负形）。
  背景为纯色 #0B1B3A，播放三角用同色填充，因此在启动器里呈现为“挖空”效果，
  同时在浅色背景下也能作为两色标识正常显示。
  画布 512 逻辑坐标，通过 group 等比映射到 108dp 自适应图标安全区。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="-2.576"
        android:translateY="-1.25"
        android:scaleX="0.221"
        android:scaleY="0.221">

        <!-- 云体：中间大拱 + 左右两个小拱 + 圆角底座（同一 fillColor，叠加即并集） -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M160,246 a94,94 0 1 0 188,0 a94,94 0 1 0 -188,0 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M120,284 a52,52 0 1 0 104,0 a52,52 0 1 0 -104,0 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M288,284 a52,52 0 1 0 104,0 a52,52 0 1 0 -104,0 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M156,258 h200 a38,38 0 0 1 38,38 v14 a38,38 0 0 1 -38,38 h-200 a38,38 0 0 1 -38,-38 v-14 a38,38 0 0 1 38,-38 Z" />

        <!-- 播放键（与背景同色，形成负形） -->
        <path
            android:fillColor="#0B1B3A"
            android:pathData="M232,208 L232,300 L310,254 Z" />
    </group>
</vector>
